# Copy to `.env` and fill in to turn on cloud sync. Leave both blank (or don't
# create `.env` at all) to keep everything local to this browser.
#
# Both values are in Supabase → Project Settings → API. Use the anon/public key,
# never the service-role key: this one is baked into the bundle.
#
# The app recognises these template values and says so in the sidebar rather
# than showing a sign-in form that can only fail.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: keep images and PDFs in OneDrive instead of Supabase Storage.
# The "Application (client) ID" of your app registration in the Microsoft Entra
# admin centre — see "OneDrive for images and PDFs" in the README. Leave blank
# to use Supabase Storage.
VITE_ONEDRIVE_CLIENT_ID=

# Optional: keep images and PDFs in Google Drive (15 GB free). The OAuth
# *client ID* from Google Cloud (ends in .apps.googleusercontent.com) — the
# client secret goes in the Supabase Edge Function's secrets, never here. See
# "Google Drive for images and PDFs" in the README.
VITE_GOOGLE_CLIENT_ID=
